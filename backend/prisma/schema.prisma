datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Role {
  CUSTOMER
  OWNER
}

enum CourtType {
  SINGLE
  DOUBLE
}

enum BookingStatus {
  PENDING_PAYMENT
  PAID
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  SEPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model Court {
  id        String    @id @default(uuid())
  name      String
  type      CourtType
  basePrice Int
  isActive  Boolean   @default(true)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Booking {
  id              String        @id @default(uuid())
  court           Court         @relation(fields: [courtId], references: [id])
  courtId         String
  user            User          @relation("BookingUser", fields: [userId], references: [id])
  userId          String
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  unitPrice       Int
  totalPrice      Int
  status          BookingStatus
  expiresAt       DateTime
  canceledAt      DateTime?
  canceledBy      String?
  canceledByUser  User?         @relation("BookingCanceledBy", fields: [canceledBy], references: [id])
  cancelReason    String?
  refundPolicy    String?
  refundAmount    Int?
  refundStatus    String?
  refundTransactions RefundTransaction[]
  paymentTransactions PaymentTransaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([courtId, startTime, endTime, status])
  @@index([status, startTime])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([expiresAt, status])
}

model RefundTransaction {
  id        String   @id @default(uuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String   @unique
  amount    Int
  currency  String   @default("VND")
  policy    String
  status    String
  source    String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model PaymentTransaction {
  id                String         @id @default(uuid())
  bookingId         String
  booking           Booking        @relation(fields: [bookingId], references: [id])
  provider          PaymentProvider
  status            PaymentStatus  @default(PENDING)
  amount            Int
  currency          String
  externalOrderId   String
  externalRequestId String?
  payUrl            String?
  qrString          String?
  meta              Json?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([provider, externalOrderId])
  @@index([status, createdAt])
  @@index([bookingId, status])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  fullName     String
  phone        String   @unique
  email        String   @unique
  role         Role
  bookings     Booking[] @relation("BookingUser")
  canceledBookings Booking[] @relation("BookingCanceledBy")
  refreshTokens RefreshToken[]
  loginAudits   LoginAudit[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RefreshToken {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  tokenHash  String   @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
}

model LoginAudit {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    AuditAction
  status    AuditStatus
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

enum AuditAction {
  REGISTER
  LOGIN
}

enum AuditStatus {
  SUCCESS
  FAILED
}

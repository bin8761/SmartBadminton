        "config": {
          "language": "ts",
          "query": "",
          "tscript": "const json = pm.response.json();\r\nconst courts = json?.data?.courts || [];\r\nif (!courts.length) {\r\n  throw new Error(\"No available courts\");\r\n}\r\npm.collectionVariables.set(\"courtId\", courts[0].id);\r\n",

      "yd0a3Mct": {
        "type": "logic/manipulate@1",
        "pos": {
          "x": 120,
          "y": -168
        },
        "size": {
          "width": 304,
          "height": 104
        },
        "config": {
          "language": "ts",
          "query": "",
          "tscript": "const now = new Date();\r\nconst gmt7 = new Date(now.getTime() + 7 * 60 * 60 * 1000);\r\n\r\nconst pad = (n) => String(n).padStart(2, \"0\");\r\nconst date = `${gmt7.getUTCFullYear()}-${pad(gmt7.getUTCMonth()+1)}-${pad(gmt7.getUTCDate())}`;\r\n\r\nconst start = new Date(gmt7.getTime() + 2 * 60 * 60 * 1000);\r\nconst end = new Date(gmt7.getTime() + 3 * 60 * 60 * 1000);\r\n\r\nconst startTime = `${pad(start.getUTCHours())}:${pad(start.getUTCMinutes())}`;\r\nconst endTime = `${pad(end.getUTCHours())}:${pad(end.getUTCMinutes())}`;\r\n\r\npm.collectionVariables.set(\"date\", date);\r\npm.collectionVariables.set(\"startTime\", startTime);\r\npm.collectionVariables.set(\"endTime\", endTime);\r\n",
          "variables": [
            {
              "id": "ypmr5ACg",
              "type": "value/reference@2",
              "kind": "reference",
              "value": "",
              "key": "value1",
              "__noIn": true
            }
          ],
          "variables__expanded": true
        },
        "ui": {
          "data": {
            "blockTitle": "date"
          },
          "namedInputsExpanded": true
        }
      },

    "/api/payments/webhooks/sepay": {
      "post": {
        "summary": "SePay webhook",
        "security": [
          {
            "sepayApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payment_code": {
                    "type": "string",
                    "nullable": true
                  },
                  "content": {
                    "type": "string",
                    "nullable": true
                  },
                  "transaction_content": {
                    "type": "string",
                    "nullable": true
                  },
                  "amount": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "nullable": true
                  },
                  "transfer_type": {
                    "type": "string",
                    "nullable": true
                  },
                  "transaction_id": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "nullable": true
                  },
                  "transaction_date": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook received"
          },

    "/api/bookings/{bookingId}/cancel": {
      "post": {
        "summary": "Cancel booking",
        "parameters": [
          {
            "in": "path",
            "name": "bookingId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 500,
                    "example": "Ban viec dot xuat, khong the den san"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking canceled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "bookingId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "CANCELED"
                          ]
                        },
                        "canceledAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "refundPolicy": {
                          "type": "string",
                          "enum": [
                            "REFUND_70",
                            "NO_REFUND"
                          ]
                        },
                        "refundAmount": {
                          "type": "integer",
                          "example": 0
                        },
                        "refundStatus": {
                          "type": "string",
                          "enum": [
                            "PENDING_MANUAL",
                            "COMPLETED_MANUAL",
                            "REJECTED_MANUAL"
                          ]
                        },
                        "refundTransactionId": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid cancel payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidCancelReason": {
                    "value": {
                      "status": "error",
                      "code": "INVALID_CANCEL_REASON",
                      "message": "Du lieu khong hop le"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "status": "error",
                      "code": "UNAUTHORIZED",
                      "message": "Chua dang nhap"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not owner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "bookingNotOwned": {
                    "value": {
                      "status": "error",
                      "code": "BOOKING_NOT_OWNED",
                      "message": "Don dat san khong thuoc nguoi dung hien tai"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Booking not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "bookingNotFound": {
                    "value": {
                      "status": "error",
                      "code": "BOOKING_NOT_FOUND",
                      "message": "Khong tim thay don dat san"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Booking cannot be canceled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "bookingAlreadyCanceled": {
                    "value": {
                      "status": "error",
                      "code": "BOOKING_ALREADY_CANCELED",

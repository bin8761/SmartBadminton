                    }
                  },
                  "bookingStatusNotCancellable": {
                    "value": {
                      "status": "error",
                      "code": "BOOKING_STATUS_NOT_CANCELLABLE",
                      "message": "Trang thai don dat san khong cho phep huy"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "internalError": {
                    "value": {
                      "status": "error",
                      "code": "INTERNAL_ERROR",
                      "message": "Khong the huy booking"
                    }
                  }
                }
              }
            }
          }
        }
      }
